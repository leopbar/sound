# ============================ Autenticação ============================
# URL pública do app, exatamente como o usuário acessa (sem barra no final).
# Local: http://localhost:8080 · VPS: https://sound.seudominio.com
APP_URL=http://localhost:8080

# Subcaminho do app quando ele não fica na raiz do domínio (ex.: APP_URL=https://seudominio.com/sound
# -> BASE_PATH=/sound). Vazio = raiz. Precisa bater com o caminho do APP_URL.
BASE_PATH=

# Domínio para o HTTPS automático (Caddy, perfil "https"). Ex.: sound.seudominio.com
DOMAIN=
# Com o Caddy na frente, deixe a porta HTTP do app só no localhost do VPS.
CLIENT_BIND=0.0.0.0

# OBRIGATÓRIOS. Gere valores aleatórios:  openssl rand -base64 32
BETTER_AUTH_SECRET=
POSTGRES_PASSWORD=

# Recomendado em produção: com SMTP, o e-mail precisa ser confirmado e a recuperação
# de senha funciona. Sem ele, os links aparecem no log do servidor (docker compose logs server).
# Ex.: smtps://usuario:senha@smtp.seuprovedor.com:465
SMTP_URL=
MAIL_FROM=Sound <no-reply@seudominio.com>

# Opcional: login social. Callback a cadastrar no provedor:
#   {APP_URL}/api/auth/callback/google   e   {APP_URL}/api/auth/callback/github
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# false = fecha o cadastro público (quem já tem conta continua entrando)
SIGNUP_ENABLED=true

# ============================ Música ============================
# Opcional. Sem chave, o backend usa a busca interna do YouTube (scraping da página de resultados).
YOUTUBE_API_KEY=

# Opcional. Só para tocar faixas do Jamendo já salvas em playlists (https://devportal.jamendo.com).
JAMENDO_CLIENT_ID=

# User-Agent enviado ao LRCLIB (letras): identifique sua aplicação e um contato.
MB_USER_AGENT=SoundPlayer/1.0.0 ( seu-email@exemplo.com )

# Opcional. Cookies do YouTube (array JSON exportado do navegador) caso o YouTube
# exija verificação anti-bot ("Sign in to confirm you're not a bot").
YT_COOKIES=

# Porta publicada do frontend (docker-compose.yml). Se mudar, ajuste APP_URL.
CLIENT_PORT=8080

# Tempo (ms) por tentativa de conexão IPv4/IPv6 do Node (padrão do Node: 250; aqui 2000)
NET_FAMILY_TIMEOUT_MS=2000
