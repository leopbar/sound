# Opcional. Sem chave, o backend usa a busca interna do YouTube (scraping da página de resultados).
YOUTUBE_API_KEY=

# Opcional. Habilita o fallback Jamendo (https://devportal.jamendo.com).
JAMENDO_CLIENT_ID=

# Obrigatório pela política da MusicBrainz: identifique sua aplicação e um contato.
MB_USER_AGENT=SoundPlayer/1.0.0 ( seu-email@exemplo.com )

# Opcional. Cookies do YouTube (array JSON exportado do navegador) caso o YouTube
# exija verificação anti-bot ("Sign in to confirm you're not a bot").
YT_COOKIES=

SEARCH_LIMIT=12

# Porta publicada do frontend (docker-compose.yml)
CLIENT_PORT=8080

# Tempo (ms) por tentativa de conexão IPv4/IPv6 do Node (padrão do Node: 250; aqui 2000)
NET_FAMILY_TIMEOUT_MS=2000

# Busca: quantas faixas resolver no YouTube em paralelo e teto (ms) do fallback por faixa
RESOLVE_CONCURRENCY=12
FALLBACK_TIMEOUT_MS=1500

# Peso da popularidade (views do YouTube, escala log10) na ordem dos resultados
POPULARITY_WEIGHT=10
